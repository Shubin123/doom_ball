- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport cv2\n\nclass\
      \ doom_4gfsk_decoder(gr.basic_block):\n    def __init__(self, width=320, height=200,\
      \ sync_header=b'\\xDE\\xAD\\xBE\\xEF'):\n        gr.basic_block.__init__(self,\n\
      \            name=\"DOOM 4-GFSK Frame Decoder & Renderer\",\n            in_sig=[np.float32],\
      \ # Synchronized symbols from Symbol Sync\n            out_sig=None)\n\n   \
      \     self.WIDTH = width\n        self.HEIGHT = height\n        self.FRAME_BYTES\
      \ = self.WIDTH * self.HEIGHT\n        self.SYNC_HEADER = sync_header\n     \
      \   self.buffer = bytearray()\n        \n        # 4-Level Slicing Thresholds\n\
      \        self.T1 = -0.66\n        self.T2 = 0.0\n        self.T3 = 0.66\n  \
      \      \n        # Fast lookup table mapping the 4 levels to 2-bit pairs\n \
      \       self.bit_table = np.array([\n            [0, 0],  # Level 0 (< T1)\n\
      \            [0, 1],  # Level 1 (T1 to T2)\n            [1, 0],  # Level 2 (T2\
      \ to T3)\n            [1, 1]   # Level 3 (>= T3)\n        ], dtype=np.uint8)\n\
      \n    def general_work(self, input_items, output_items):\n        in_symbols\
      \ = input_items[0]\n        symbols_consumed = len(in_symbols)\n\n        if\
      \ symbols_consumed == 0:\n            return 0\n\n        # 1. Blazing fast\
      \ vectorized slicing using NumPy (C-speed execution)\n        bins = np.digitize(in_symbols,\
      \ [self.T1, self.T2, self.T3])\n        raw_bits = self.bit_table[bins].flatten()\n\
      \n        # 2. Pack bits into bytes and add to working buffer\n        bit_array\
      \ = np.packbits(raw_bits)\n        self.buffer.extend(bit_array.tobytes())\n\
      \n        # 3. Frame Synchronization via Magic Header\n        header_idx =\
      \ self.buffer.find(self.SYNC_HEADER)\n        if header_idx != -1:\n       \
      \     del self.buffer[:header_idx + len(self.SYNC_HEADER)]\n\n        # 4. Extract\
      \ and Render Full Frames smoothly\n        while len(self.buffer) >= self.FRAME_BYTES:\n\
      \            frame_raw = self.buffer[:self.FRAME_BYTES]\n            del self.buffer[:self.FRAME_BYTES]\n\
      \n            # Reconstruct pixel array\n            img = np.frombuffer(frame_raw,\
      \ dtype=np.uint8).reshape((self.HEIGHT, self.WIDTH))\n\n            # Upscale\
      \ and display live window smoothly\n            display_frame = cv2.resize(img,\
      \ (self.WIDTH * 3, self.HEIGHT * 3), interpolation=cv2.INTER_NEAREST)\n    \
      \        cv2.imshow(\"DOOM 4-GFSK Live Feed\", display_frame)\n            cv2.waitKey(1)\n\
      \n        self.consume(0, symbols_consumed)\n        return symbols_consumed"
    affinity: ''
    alias: ''
    comment: ''
    height: '240'
    maxoutbuf: '0'
    minoutbuf: '0'
    sync_header: b'\xDE\xAD\xBE\xEF'
    width: '320'
  states:
    _io_cache: ('DOOM 4-GFSK Frame Decoder & Renderer', 'doom_4gfsk_decoder', [('width',
      '320'), ('height', '200'), ('sync_header', "b'\\xde\\xad\\xbe\\xef'")], [('0',
      'float', 1)], [], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1768, 332.0]
    rotation: 0
    state: disabled
- name: epy_block_2
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nRaw byte stream -> 4-GFSK modulator, as a GNU Radio Embedded\
      \ Python Block (source, no inputs).\n\nPaste this whole file into a GRC \"Python\
      \ Block\" and wire its complex output into your existing\nchain (Complex Low\
      \ Pass Filter, decimation 1, ...). Remove the File Source / RTL-SDR Source.\n\
      The block paces itself in real time, so a Throttle is not needed (an extra one\
      \ is harmless).\n\nWhat it does\n    Bytes arriving on the link are modulated\
      \ exactly as received: 2 bits per symbol, MSB\n    first, 00 -> -1, 01 -> -1/3,\
      \ 10 -> +1/3, 11 -> +1 (times `deviation`), rectangular pulses.\n    No commands,\
      \ no framing, no header added. The SENDER puts the frame sync word\n    (AA\
      \ BB CC DD) in front of every frame, exactly as in the original design.\n  \
      \  When no data is waiting the block sends an unmodulated carrier, so the stream\
      \ never stops.\n\nLink (port parameter; GRC passes it as typed, so 5558, \"\
      5558\" and \"tcp:5558\" all mean TCP)\n    \"tcp:5558\"             listen on\
      \ 127.0.0.1:5558; a sender connects (doom_raw_sender.py)\n    \"COM7\" / \"\
      /dev/ttyACM0\" open that USB-serial port (a Pico running pico_raw_usb.py)\n\
      \    The block stops reading when its buffer is full (max_buffer bytes, 0 =\
      \ default 65536), so the sender is\n    slowed to the real symbol rate by normal\
      \ flow control (TCP window / USB).\n\nsamp_rate / symbol_rate must be an integer.\
      \ Single-threaded: the link is polled from work().\n\"\"\"\nimport select\n\
      import socket\nimport time\n\nimport numpy as np\nfrom gnuradio import gr\n\n\
      LEAD = 1024            # samples the engine may run ahead of the wall clock\n\
      MIN_PRODUCE = 512\nMAX_PRODUCE = 1024\nUNIT_BYTES = 64        # bytes modulated\
      \ per refill (64 bytes = 256 symbols = 1024 samples at 4 sps)\nIDLE_SYMS = 64\n\
      \n\nclass blk(gr.sync_block):\n    def __init__(self, port=\"tcp:5558\", samp_rate=2500000.0,\
      \ symbol_rate=625000.0,\n                 deviation=125000.0, gray=False, max_buffer=65536,\
      \ realtime=False):\n        gr.sync_block.__init__(self, name=\"Raw 4-GFSK Mod\"\
      , in_sig=None,\n                               out_sig=[np.complex64])\n   \
      \     sps = float(samp_rate) / float(symbol_rate)\n        if abs(sps - round(sps))\
      \ > 1e-9 or round(sps) < 1:\n            raise ValueError(\"samp_rate / symbol_rate\
      \ must be an integer, got %r\" % sps)\n        self.sps = int(round(sps))\n\
      \        self.fs = float(samp_rate)\n        self.dev = float(deviation)\n \
      \       # GRC passes parameters exactly as typed, so accept 5558, \"5558\" and\
      \ \"tcp:5558\" as the\n        # TCP port, and anything else (\"COM7\", \"/dev/ttyACM0\"\
      ) as a serial port.\n        p = str(port).strip().strip(\"'\\\"\")\n      \
      \  if p.lower().startswith(\"tcp:\"):\n            p = p[4:]\n        self._tcp_port\
      \ = int(p) if p.isdigit() else None\n        self.port = p\n        mb = int(max_buffer)\
      \ if str(max_buffer).strip() else 0\n        self.max_buffer = mb if mb > 0\
      \ else 65536        # 0 / blank = default\n        self.realtime = str(realtime).strip().lower()\
      \ in (\"1\", \"true\", \"yes\")\n\n        lv = np.array([-1.0, -1.0 / 3.0,\
      \ 1.0 / 3.0, 1.0])\n        sym_to_level = np.array([0, 1, 3, 2]) if gray else\
      \ np.array([0, 1, 2, 3])\n        self.sym_freq = lv[sym_to_level]\n       \
      \ self._idle = np.zeros(IDLE_SYMS)\n\n        self.buf = bytearray()\n     \
      \   self.iq = np.zeros(0, dtype=np.complex64)\n        self.phase = 0.0\n  \
      \      self.t0 = None\n        self.emitted = 0\n        self.bytes_in = 0\n\
      \        self.bytes_mod = 0\n        self.idle_syms = 0\n\n        self._conn\
      \ = None\n        self._srv = None\n        self._ser = None\n        if self._tcp_port\
      \ is not None:\n            self._srv = socket.socket()\n            self._srv.setsockopt(socket.SOL_SOCKET,\
      \ socket.SO_REUSEADDR, 1)\n            self._srv.bind((\"127.0.0.1\", self._tcp_port))\n\
      \            self._srv.listen(1)\n        else:\n            import serial\n\
      \            self._ser = serial.Serial(self.port, 115200, timeout=0)   # baud\
      \ ignored by USB CDC\n            self._ser.reset_input_buffer()\n\n    # ----------------\
      \ link ----------------\n    def _poll_link(self, timeout):\n        \"\"\"\
      Read whatever has arrived (never blocks longer than `timeout` seconds).\"\"\"\
      \n        room = self.max_buffer - len(self.buf)\n        if self._ser is not\
      \ None:\n            deadline = time.perf_counter() + max(0.0, timeout)\n  \
      \          while True:\n                room = self.max_buffer - len(self.buf)\n\
      \                try:\n                    n = self._ser.in_waiting if room\
      \ > 0 else 0\n                    if n:\n                        d = self._ser.read(min(n,\
      \ room))\n                        self.buf += d\n                        self.bytes_in\
      \ += len(d)\n                except Exception as e:\n                    print(\"\
      [Raw 4-GFSK Mod] serial error:\", e)\n                    return\n         \
      \       if time.perf_counter() >= deadline:\n                    return\n  \
      \              time.sleep(0.0002)\n        socks = [self._srv] + ([self._conn]\
      \ if self._conn is not None and room > 0 else [])\n        try:\n          \
      \  ready, _, _ = select.select(socks, [], [], max(0.0, timeout))\n        except\
      \ (OSError, ValueError):\n            return\n        for sk in ready:\n   \
      \         if sk is self._srv:\n                c, _ = sk.accept()\n        \
      \        if self._conn is not None:\n                    self._conn.close()\n\
      \                self._conn = c\n                self.buf.clear()\n        \
      \        continue\n            try:\n                d = sk.recv(min(65536,\
      \ room))\n            except OSError:\n                d = b\"\"\n         \
      \   if not d:\n                sk.close()\n                self._conn = None\n\
      \                continue\n            self.buf += d\n            self.bytes_in\
      \ += len(d)\n\n    # ---------------- modulator ----------------\n    def _next_levels(self):\n\
      \        if self.buf:\n            data = bytes(self.buf[:UNIT_BYTES])\n   \
      \         del self.buf[:UNIT_BYTES]\n            self.bytes_mod += len(data)\n\
      \            bits = np.unpackbits(np.frombuffer(data, dtype=np.uint8))\n   \
      \         sym = (bits[0::2].astype(np.int64) << 1) | bits[1::2]\n          \
      \  return self.sym_freq[sym]\n        self.idle_syms += IDLE_SYMS\n        return\
      \ self._idle                       # unmodulated carrier while no data waits\n\
      \n    def _refill(self, target):\n        while self.iq.size < target:\n   \
      \         freq = np.repeat(self._next_levels(), self.sps) * self.dev\n     \
      \       phase = self.phase + 2.0 * np.pi * np.cumsum(freq) / self.fs\n     \
      \       self.phase = float(phase[-1] % (2.0 * np.pi))\n            iq = np.exp(1j\
      \ * np.mod(phase, 2.0 * np.pi)).astype(np.complex64)\n            self.iq =\
      \ np.concatenate((self.iq, iq))\n\n    def work(self, input_items, output_items):\n\
      \        out = output_items[0]\n        n = len(out)\n        if not self.realtime:\
      \                       # free-running: the Throttle sets the rate\n       \
      \     self._poll_link(0.0)\n            k = min(n, 8192)\n            self._refill(k)\n\
      \            out[:k] = self.iq[:k]\n            self.iq = self.iq[k:]\n    \
      \        self.emitted += k\n            return k\n        if self.t0 is None:\n\
      \            self.t0 = time.perf_counter() - LEAD / self.fs\n        while True:\n\
      \            self._poll_link(0.0)\n            now = time.perf_counter()\n \
      \           allowed = int((now - self.t0) * self.fs) + LEAD - self.emitted\n\
      \            if allowed > LEAD + 4 * MAX_PRODUCE:          # fell behind: drop\
      \ the lag\n                self.t0 = now - self.emitted / self.fs\n        \
      \        allowed = LEAD\n            if allowed >= MIN_PRODUCE:\n          \
      \      break\n            self._poll_link((MIN_PRODUCE - allowed) / self.fs)\
      \   # real-time wait that also reads the link\n        k = max(1, min(n, MAX_PRODUCE,\
      \ allowed))\n        self._refill(k)\n        out[:k] = self.iq[:k]\n      \
      \  self.iq = self.iq[k:]\n        self.emitted += k\n        return k\n\n  \
      \  def stop(self):\n        for sk in (self._conn, self._srv, self._ser):\n\
      \            try:\n                if sk is not None:\n                    sk.close()\n\
      \            except Exception:\n                pass\n        print(\"[Raw 4-GFSK\
      \ Mod] bytes in %d, modulated %d, idle %.2f s\"\n              % (self.bytes_in,\
      \ self.bytes_mod, self.idle_syms / (self.fs / self.sps)))\n        return True"
    affinity: ''
    alias: ''
    comment: ''
    deviation: fsk_deviation_hz
    gray: 'False'
    max_buffer: '65536'
    maxoutbuf: '0'
    minoutbuf: '0'
    port: '5558'
    realtime: 'False'
    samp_rate: samp_rate
    symbol_rate: sym_rate
  states:
    _io_cache: ('Raw 4-GFSK Mod', 'blk', [('port', "'tcp:5558'"), ('samp_rate', '2500000.0'),
      ('symbol_rate', '625000.0'), ('deviation', '125000.0'), ('gray', 'False'), ('max_buffer',
      '65536'), ('realtime', 'False')], [], [('0', 'complex', 1)], '', ['max_buffer',
      'port', 'realtime'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [80, 428.0]
    rotation: 0
    state: disabled
