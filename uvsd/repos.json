            "uv",
            "run",
            "--frozen",
            "mypy"
          ]
        },
        {
          "label": "pytest",
          "needs": [
            "uv"
          ],
          "run": [
            "uv",
            "run",
            "--frozen",
            "pytest",
            "-q"
          ]
        }
      ],
      "project": "DOOM balloon",
      "ide": true
    },
    {
      "id": "uvsd-pico-bridge",
      "name": "Pico bridge",
      "role": "Raspberry Pi Pico 2 SPI-slave bridge and laptop USB receiver for payload frames",
      "lang": "C, Python",
      "sdk": "pico",
      "setup": [
        {
          "label": "receiver: uv sync --frozen",
          "needs": [
            "uv"
          ],
          "run": [
            "uv",
            "sync",
            "--frozen"
          ],
          "cwd": "usb_laptop"
        }
      ],
      "test": [
        {
          "label": "receiver: pytest (Pico byte stream over a pty)",
          "needs": [
            "uv"
          ],
          "run": [
            "uv",
            "run",
            "--frozen",
            "pytest",
            "-q"
          ],
          "cwd": "usb_laptop"
        },
        {
          "label": "RP2350 firmware build (spi_connection.uf2)",
          "needs": [
            "arm",
            "cmake",
            "pico"
          ],
          "run": [
            "bash",
            "build.sh"
          ],
          "cwd": "spi_connection"
        }
      ],
      "project": "DOOM balloon",
      "ide": true
    },
    {
      "id": "uvsd-doom-gnu-radio",
      "name": "GNU Radio link",
      "role": "GNU Radio Companion flowgraph and scripts for the 915 MHz DOOM video link, with recorded gameplay",
      "lang": "Python",
      "lfs": true,
      "setup": [],
      "test": [
        {
          "label": "Python scripts compile",
          "needs": [
            "uv"
