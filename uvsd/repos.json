    {
      "id": "GroundStation",
      "name": "HAB ground station",
      "role": "2024 high-altitude-balloon ground station GUI (PyQt5, Leaflet map, APRS via RTL-SDR)",
      "lang": "Python",
      "project": "High-altitude balloon",
      "private": true,
      "setup": [
        {
          "label": "resolve the pinned requirements (Python 3.12)",
          "needs": [
            "uv"
          ],
          "run": [
            "uv",
            "run",
            "--no-project",
            "--python",
            "3.12",
            "--with-requirements",
            "requirements.txt",
            "python",
            "-c",
            "import PyQt5.QtWebEngineWidgets, pyqtgraph, aprspy"
          ]
        }
      ],
      "test": [
        {
          "label": "black --check",
          "needs": [
            "uv"
          ],
          "run": [
            "uv",
            "run",
            "--no-project",
            "--python",
            "3.12",
            "--with-requirements",
            "requirements.txt",
            "black",
            "--check",
            "."
          ]
        },
        {
          "label": "GUI imports and CLI help (headless)",
          "needs": [
            "uv"
          ],
          "run": [
            "uv",
            "run",
            "--no-project",
            "--python",
            "3.12",
            "--with-requirements",
            "requirements.txt",
            "python",
            "frontend.py",
            "-h"
          ],
          "env": {
            "QT_QPA_PLATFORM": "offscreen",
            "PYTHONDONTWRITEBYTECODE": "1"
          }
        }
      ]
    },
