        {
          "label": "Gerber and drill files parse (gerbonara)",
          "needs": [
            "uv"
          ],
          "run": [
            "uv",
            "run",
            "--no-project",
            "--python",
            "3.12",
            "--with",
            "gerbonara==1.5.0",
            "python",
            "-W",
            "ignore",
            "-c",
            "import glob; from gerbonara import GerberFile, ExcellonFile; [print(f, len(GerberFile.open(f).objects), 'objects') for f in sorted(glob.glob('manufacturing/*.gbr'))]; print('drill hits', len(list(ExcellonFile.open('manufacturing/PAY_EGSE.TXT').drills())))"
          ]
        }
      ]
    }
