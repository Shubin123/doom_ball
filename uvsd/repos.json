      ],
      "project": "DOOM balloon"
    },
    {
      "id": "uvsd-doom-nrf-pcb",
      "name": "nRF PCB",
      "role": "Altium copy of the nRF5340 DK reference design used for the DOOM payload",
      "lang": "Altium",
      "private": true,
      "setup": [],
      "test": [
        {
          "label": "design and fabrication files are intact",
          "run": [
            "hardware"
          ]
        }
      ],
      "project": "DOOM balloon"
    }
  ]
}
