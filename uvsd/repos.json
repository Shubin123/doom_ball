            "arduino:avr:uno",
            "as1115"
          ]
        },
        {
          "label": "Compile the I2C scanner sketch for the Uno",
          "needs": [
            "arduino-cli"
          ],
          "run": [
            "arduino-cli",
            "compile",
            "--fqbn",
            "arduino:avr:uno",
            "i2c_scanner"
          ]
        }
      ],
      "project": "Libraries and training"
    },
    {
      "id": "satnogs_relayCtrl",
      "name": "SatNOGS relay controller",
      "role": "Serial/GPIO-controlled relay and fan firmware for the SatNOGS ground station (Anet ATmega1284P board)",
      "lang": "C++ (Arduino)",
      "setup": [
        {
          "label": "Fetch the MightyCore board index",
          "needs": [
            "arduino-cli"
          ],
          "run": [
            "arduino-cli",
            "core",
            "update-index",
            "--additional-urls",
            "https://mcudude.github.io/MightyCore/package_MCUdude_MightyCore_index.json"
          ]
        },
        {
          "label": "Install the MightyCore ATmega1284P core",
          "needs": [
            "arduino-cli"
          ],
          "run": [
            "arduino-cli",
            "core",
            "install",
            "MightyCore:avr@3.1.0",
            "--additional-urls",
            "https://mcudude.github.io/MightyCore/package_MCUdude_MightyCore_index.json"
          ]
        }
      ],
      "test": [
        {
          "label": "Compile the relay sketch for the ATmega1284P (Sanguino pinout)",
          "needs": [
            "arduino-cli"
          ],
          "run": [
            "sh",
            "-c",
            "t=$(mktemp -d) && mkdir \"$t/triggerRelays\" && cp triggerRelays.ino \"$t/triggerRelays/\" && arduino-cli compile --fqbn MightyCore:avr:1284:variant=modelP,pinout=sanguino,clock=16MHz_external \"$t/triggerRelays\"; s=$?; rm -rf \"$t\"; exit $s"
          ]
        }
      ],
      "project": "SatNOGS ground station",
      "private": true
    },
    {
      "id": "satnogs",
      "name": "SatNOGS station scripts",
      "role": "Provisioning, hardening and launch scripts for the UVSD SatNOGS ground-station host",
      "lang": "Shell, Python",
      "setup": [
        {
          "label": "Fetch pyserial for the relay control script",
          "needs": [
            "uv"
          ],
          "run": [
            "uv",
            "run",
            "--no-project",
            "--with",
            "pyserial",
            "python",
            "-B",
            "-c",
            "import serial; print('pyserial', serial.__version__)"
          ]
        }
      ],
      "test": [
        {
          "label": "Parse every script with bash -n",
          "run": [
            "bash",
            "-c",
            "for f in scripts/*.sh; do bash -n \"$f\" || exit 1; done; echo \"parsed $(ls scripts/*.sh | wc -l | tr -d ' ') scripts\""
          ]
        },
        {
          "label": "Shellcheck the scripts (errors only)",
          "needs": [
            "shellcheck"
          ],
          "run": [
            "bash",
            "-c",
            "shellcheck --shell=bash --severity=error scripts/*.sh && echo shellcheck clean"
          ]
        },
        {
          "label": "Dry-run the client launcher with a stub docker",
          "run": [
            "bash",
            "-c",
            "d=$(mktemp -d) && printf '#!/bin/sh\\necho stub: docker \"$@\"\\n' > \"$d/docker\" && chmod +x \"$d/docker\" && PATH=\"$d:$PATH\" bash scripts/run_satnogs_client.sh; s=$?; rm -rf \"$d\"; exit $s"
          ]
        },
        {
          "label": "Relay control script rejects bad arguments",
          "needs": [
            "uv"
          ],
          "run": [
            "uv",
            "run",
            "--no-project",
            "--with",
            "pyserial",
            "python",
            "-B",
            "-c",
            "import sys\nsys.path.insert(0, 'scripts')\nimport relay_control\nfor argv, err in ((['r3', 'on'], ValueError), (['r1', 'dim'], ValueError), (['r1', 'on'], RuntimeError)):\n    sys.argv = ['relay_control.py'] + argv\n    try:\n        relay_control.main()\n    except err as e:\n        print('ok', argv, type(e).__name__)\n    else:\n        sys.exit('no error for %s' % argv)"
          ]
        }
      ],
      "project": "SatNOGS ground station",
      "private": true
    }
  ]
}
