            "uv"
          ],
          "run": [
            "uv",
            "run",
            "--no-project",
            "--quiet",
            "--with",
            "numpy",
            "python",
            "tests/replay_recordings.py"
          ]
        }
      ],
      "project": "DOOM balloon",
      "ide": true
    },
