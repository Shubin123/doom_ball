            "uv",
            "run",
            "--no-project",
            "--quiet",
            "python",
            "-m",
            "compileall",
            "-q",
            "-x",
            "/\\.",
            "."
          ]
        },
        {
          "label": "viewers decode the recordings at link rate (tests/replay_recordings.py)",
