    {
      "id": "UVSD-Star-tracker",
      "name": "Star tracker",
      "role": "Lost-in-space star identification and star-field sensor simulator (C++), plus a Python centroid/feature pipeline",
      "lang": "C++17, Python",
      "setup": [
        {
          "label": "Fetch Python deps for the centroid pipeline",
          "needs": [
            "uv"
          ],
          "run": [
            "uv",
            "run",
            "--no-project",
            "--with",
            "numpy",
            "--with",
            "opencv-python-headless",
            "python",
            "-B",
            "-c",
            "import numpy, cv2; print('numpy', numpy.__version__, 'cv2', cv2.__version__)"
          ]
        }
      ],
      "test": [
        {
          "label": "Create the gitignored build dir",
          "run": [
            "mkdir",
            "-p",
            "out"
          ]
        },
        {
          "label": "Build the simulator with the host C++ compiler",
          "needs": [
            "cc"
          ],
          "run": [
            "c++",
            "-std=c++17",
            "-O2",
            "-w",
            "-o",
            "out/star_tracker",
            "astrometry.cpp",
            "database.cpp",
            "linear_algebra.cpp",
            "sensor_sim.cpp",
            "Source.cpp",
            "trees.cpp"
          ]
        },
        {
          "label": "Render a synthetic star field (writes out/test_starfield.png)",
          "run": [
            "sh",
            "-c",
            "cd out && ./star_tracker"
          ]
        },
        {
          "label": "Python centroid and feature extraction smoke test",
          "needs": [
            "uv"
          ],
          "cwd": "python",
          "run": [
            "uv",
            "run",
            "--no-project",
            "--with",
            "numpy",
            "--with",
            "opencv-python-headless",
            "python",
            "-B",
            "-c",
            "import numpy as np, catalog_parse, tumble, synthesize_image, process_centroids, centroids, feature_extraction\nimg = np.zeros((64, 64), np.uint16)\nstars = [(12, 10), (30, 40), (50, 20), (8, 50)]\nfor x, y in stars: img[y-1:y+2, x-1:x+2] = 1000\ncs = centroids.extract_centroids(img, 50.0)\npts = sorted((round(s.x), round(s.y)) for s in cs)\nassert pts == sorted(stars), pts\nang, nbr = feature_extraction.extract_features([(s.x, s.y) for s in cs], 2, 0.5, 1.0, 64, 64)\nassert ang.shape == (4, 2) and (ang > 0).all(), ang\nprint('centroids', pts, 'features', ang.shape)"
          ]
        }
      ],
      "project": "ADCS and star tracker"
    },
    {
      "id": "ADCS_Dev",
      "name": "ADCS reaction wheel",
      "role": "Reaction-wheel ADCS hardware (Altium/KiCad PCBs, SolidWorks) with an STSPIN230 motor-drive test sketch for the ItsyBitsy M4",
      "lang": "C++ (Arduino)",
      "setup": [
        {
          "label": "Fetch the Adafruit board index",
          "needs": [
            "arduino-cli"
