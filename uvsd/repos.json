          "run": [
            "arduino-cli",
            "core",
            "update-index",
            "--additional-urls",
            "https://adafruit.github.io/arduino-board-index/package_adafruit_index.json"
          ]
        },
        {
          "label": "Install the Adafruit SAMD core",
          "needs": [
            "arduino-cli"
          ],
          "run": [
            "arduino-cli",
            "core",
            "install",
            "adafruit:samd@1.7.17",
            "--additional-urls",
            "https://adafruit.github.io/arduino-board-index/package_adafruit_index.json"
          ]
        }
      ],
      "test": [
        {
          "label": "Compile the STSPIN230 driver sketch for the ItsyBitsy M4",
          "needs": [
            "arduino-cli"
          ],
          "run": [
            "arduino-cli",
            "compile",
            "--fqbn",
            "adafruit:samd:adafruit_itsybitsy_m4",
            "Arduino_Test/STSPIN230_Driver_No_Feedback"
          ]
        }
      ],
      "project": "ADCS and star tracker",
      "private": true
    },
